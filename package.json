{
  "name": "cookie-link",
  "version": "0.1.0",
  "description": "Chrome extension that copies cookies from the active tab onto a target URL's domain, then opens it.",
  "private": true,
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "generate-promo-images": "node scripts/generate-promo-images.js",
    "build:options": "vite build",
    "dev:options": "vite",
    "sync-version": "node scripts/sync-version.js",
    "build": "npm run build:options && npm run sync-version && node scripts/build.js",
    "publish:chrome": "node scripts/publish-chrome-web-store.js",
    "version": "npm run sync-version && git add manifest.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/subhajitdas298/cookie-link"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "chrome-webstore-upload": "^6.0.0",
    "pngjs": "^7.0.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
